---
import Layout from '../../layouts/Layout.astro';import Icon from '../../components/Icon.astro';import BottomCta from '../../components/BottomCta.astro';import {regions} from '../../data/site';
---
<Layout title="Hizmet Bölgeleri | Beylikdüzü ve Çevresi · Alfa Çilingir" description="Beylikdüzü, Esenyurt, Büyükçekmece, Avcılar ve Bahçeşehir çilingir hizmet bölgeleri. Mahallenize göre kapı açma ve kilit hizmetlerini inceleyin." crumbs={[{name:'Bölgeler',url:'/bolgeler/'}]}><div class="container"><header class="page-intro"><div class="eyebrow">HİZMET BÖLGELERİMİZ</div><h1>Mahallenizde bir<br/>telefon kadar yakınız.</h1><p>Beylikdüzü’nden İstanbul’un batısına uzanan hizmet alanımız. Bölgenizi seçin, mahalleleri ve konumunuza göre servis bilgilerini inceleyin.</p></header><div class="index-grid">{regions.map(r=><article class="region-index-card"><Icon name="pin" size={30}/><h2>{r.name} çilingir</h2><p>{r.name==='Bahçeşehir'?'Başakşehir’e bağlı Bahçeşehir 1. Kısım ve 2. Kısım’da adresinize göre çilingir desteği.':r.neighborhoods.slice(0,4).join(', ')+' ve diğer mahallelerde kapı ve kilit sorunları için destek.'}</p><a class="text-link" href={'/bolgeler/'+r.slug+'/'}>Bölgeyi inceleyin<Icon name="arrow" size={16}/></a></article>)}</div></div><BottomCta/></Layout>
