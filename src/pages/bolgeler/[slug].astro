---
import {
  getCollection,
  getEntryBySlug,
  type CollectionEntry,
} from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import CallToActionButton from "../../components/CallToActionButton.astro";

export async function getStaticPaths() {
  const allBolgeler = await getCollection("bolgeler");
  return allBolgeler.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<"bolgeler">;
};

const { entry } = Astro.props;

const { Content } = await entry.render();

const crumbs = [
  { label: "Anasayfa", url: "/" },
  { label: "Bölgeler", url: "/bolgeler" },
  {
    label: entry.data.shortTitle || entry.data.title,
    url: `/bolgeler/${entry.slug}`,
  },
];
---

<Layout title={entry.data.title} description={entry.data.description}>
  <article class="mx-auto px-6 py-12 max-w-4xl">
    <CallToActionButton />
    <Breadcrumb crumbs={crumbs} />
    <div class="prose max-w-none mt-8">
      <h1>{entry.data.title}</h1>
      {
        entry.data.image && (
          <Image
            src={entry.data.image}
            alt={entry.data.title}
            width={1200}
            height={600}
            class="rounded-xl shadow-lg my-8"
            fetchpriority="high"
          />
        )
      }
      <Content />
    </div>
  </article>
</Layout>
