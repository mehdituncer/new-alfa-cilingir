---
import ArticleCover from '../../components/ArticleCover.astro';
import {serviceImages,postImageKeys,regionImageKeys} from '../../data/images';
import Layout from '../../layouts/Layout.astro';import ArticleAside from '../../components/ArticleAside.astro';import Faq from '../../components/Faq.astro';import BottomCta from '../../components/BottomCta.astro';import {regions,services} from '../../data/site';import {regionContent} from '../../data/region-content';import {faqSchema,serviceSchema} from '../../data/schema';
export function getStaticPaths(){return regions.map(region=>({params:{slug:region.slug},props:{region,content:regionContent[region.slug]}}));}
const {region,content}=Astro.props;const url=new URL(Astro.url.pathname,Astro.site).href;const origin=Astro.site!.origin;
---
<Layout title={region.name+' Çilingir | Mahallenizde Kilit Desteği · Alfa'} description={content.description} crumbs={[{name:'Bölgeler',url:'/bolgeler/'},{name:region.name+' Çilingir',url:Astro.url.pathname}]} schema={[serviceSchema(region.name+' Çilingir',content.description,url,origin,region.name==='Bahçeşehir'?'Bahçeşehir, Başakşehir':region.name),faqSchema(content.faqs)]}><div class="container"><header class="page-intro"><div class="eyebrow">İSTANBUL · {region.area.toLocaleUpperCase('tr-TR')}</div><h1>{region.name} Çilingir</h1><ArticleCover imageKey={regionImageKeys[region.slug]}/><p>{content.intro}</p></header><div class="article-layout"><article class="article-content">{content.sections.map(section=><section><h2>{section.heading}</h2>{section.paragraphs.map(p=><p>{p}</p>)}</section>)}<section><h2>{region.name} hizmet mahalleleri</h2><p>Aşağıdaki mahallelerde açık adresinize göre hizmet uygunluğunu görüşebilirsiniz.</p><div class="neighborhoods">{region.neighborhoods.map(name=><span>{name}</span>)}</div></section><section><h2>{region.name} için çilingir hizmetleri</h2><ul>{services.map(s=><li><a href={'/hizmetler/'+s.slug+'/'}>{s.title}</a> — {s.summary}</li>)}</ul></section><section><h2>Sık sorulan sorular</h2><Faq items={content.faqs}/></section></article><ArticleAside/></div></div><BottomCta/></Layout>
