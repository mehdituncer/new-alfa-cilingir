---
import ArticleCover from '../../components/ArticleCover.astro';
import {serviceImages,postImageKeys,regionImageKeys} from '../../data/images';
import Layout from '../../layouts/Layout.astro';import ArticleAside from '../../components/ArticleAside.astro';import Faq from '../../components/Faq.astro';import editorial from '../../data/editorial.json';import {faqSchema} from '../../data/schema';
export function getStaticPaths(){return editorial.posts.map(post=>({params:{slug:post.slug},props:{post}}));}
const {post}=Astro.props;const origin=Astro.site!.origin;const url=new URL(Astro.url.pathname,Astro.site).href;
const schema=[{'@type':'Article','@id':url+'#article',headline:post.title,description:post.description,inLanguage:'tr-TR',author:{'@type':'Organization',name:'Alfa Çilingir',url:origin+'/'},publisher:{'@id':origin+'/#business'},mainEntityOfPage:{'@id':url+'#webpage'},datePublished:'2026-09-22T00:00:00+03:00',dateModified:'2026-09-22T00:00:00+03:00',articleSection:post.category,image:new URL(serviceImages[postImageKeys[post.slug]].src,origin).href},faqSchema(post.faqs)];
---
<Layout title={post.title+' | Alfa Çilingir Rehberi'} description={post.description} crumbs={[{name:'Blog',url:'/blog/'},{name:post.title,url:Astro.url.pathname}]} schema={schema}><div class="container"><header class="page-intro"><div class="post-category"><span>{post.category}</span><span>{post.readTime}</span><time datetime="2026-09-22">22 Eylül 2026</time></div><h1>{post.title}</h1><ArticleCover imageKey={postImageKeys[post.slug]}/><p>{post.intro}</p></header><div class="article-layout"><article class="article-content">{post.sections.map(section=><section><h2>{section.heading}</h2>{section.paragraphs.map(p=><p>{p}</p>)}</section>)}<section><h2>Sık sorulan sorular</h2><Faq items={post.faqs}/></section><section><h2>Profesyonel destek alın</h2><p>Sorun devam ediyorsa <a href="/hizmetler/">çilingir hizmetlerimizi</a> inceleyin veya <a href="/iletisim/">bizimle iletişime geçin</a>. Bulunduğunuz mahalle için <a href="/bolgeler/">hizmet bölgelerini</a> kontrol edebilirsiniz.</p></section><div class="info-note">Bu yazı genel bilgilendirme amaçlıdır. Kapı ve kilidinize uygun işlem, yerinde incelemeyle belirlenir.</div></article><ArticleAside/></div></div></Layout>
