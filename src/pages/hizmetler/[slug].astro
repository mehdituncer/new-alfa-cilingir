---
import ArticleCover from '../../components/ArticleCover.astro';
import {serviceImages,postImageKeys,regionImageKeys} from '../../data/images';
import Layout from '../../layouts/Layout.astro';import ArticleAside from '../../components/ArticleAside.astro';import Faq from '../../components/Faq.astro';import BottomCta from '../../components/BottomCta.astro';import editorial from '../../data/editorial.json';import {regions} from '../../data/site';import {faqSchema,serviceSchema} from '../../data/schema';
export function getStaticPaths(){return editorial.services.map(service=>({params:{slug:service.slug},props:{service}}));}
const {service}=Astro.props;const url=new URL(Astro.url.pathname,Astro.site).href;const origin=Astro.site!.origin;
---
<Layout title={service.title+' Hizmeti | Alfa Çilingir'} description={service.description} crumbs={[{name:'Hizmetler',url:'/hizmetler/'},{name:service.title,url:Astro.url.pathname}]} schema={[serviceSchema(service.title,service.description,url,origin),faqSchema(service.faqs)]}><div class="container"><header class="page-intro"><div class="eyebrow">ALFA ÇİLİNGİR · HİZMETLER</div><h1>{service.title}</h1><ArticleCover imageKey={service.slug}/><p>{service.intro}</p></header><div class="article-layout"><article class="article-content">{service.sections.map(section=><section><h2>{section.heading}</h2>{section.paragraphs.map(p=><p>{p}</p>)}</section>)}<section><h2>Hizmet verdiğimiz bölgeler</h2><p>Bölgenizdeki mahalleleri ve servis planlama bilgilerini inceleyin.</p><div class="neighborhoods">{regions.map(r=><a href={'/bolgeler/'+r.slug+'/'}><span>{r.name} çilingir</span></a>)}</div></section><section><h2>Sık sorulan sorular</h2><Faq items={service.faqs}/></section></article><ArticleAside/></div></div><BottomCta/></Layout>
