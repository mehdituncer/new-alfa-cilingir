---
import Layout from "../layouts/Layout.astro";
import { Phone, Mail } from "@lucide/astro";
---

<Layout title="İletişim - Alfa Çilingir">
  <div class="bg-white py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-semibold text-slate-900">
          Bize Ulaşın
        </h1>
        <p class="text-slate-600 mt-4 max-w-2xl mx-auto">
          Sorularınız, talepleriniz veya acil çilingir ihtiyaçlarınız için 7/24
          buradayız.
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-16 items-start">
        <!-- İletişim Formu -->
        <div class="bg-slate-50 p-8 rounded-xl shadow-lg">
          <h2 class="text-2xl font-medium mb-6 text-slate-800">
            Mesaj Gönderin
          </h2>
          <form>
            <div class="mb-5">
              <label for="name" class="block text-slate-700 font-semibold mb-2"
                >Adınız Soyadınız</label
              >
              <input
                type="text"
                id="name"
                name="name"
                class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
              />
            </div>
            <div class="mb-5">
              <label for="email" class="block text-slate-700 font-semibold mb-2"
                >E-posta Adresiniz</label
              >
              <input
                type="email"
                id="email"
                name="email"
                class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
              />
            </div>
            <div class="mb-6">
              <label
                for="message"
                class="block text-slate-700 font-semibold mb-2">Mesajınız</label
              >
              <textarea
                id="message"
                name="message"
                rows="5"
                class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
              ></textarea>
            </div>
            <div class="text-center">
              <button
                type="submit"
                class="w-full bg-blue-700 text-white font-medium py-3 px-8 rounded-lg hover:bg-blue-800 transition-transform transform hover:scale-105 shadow-lg"
                >Gönder</button
              >
            </div>
          </form>
        </div>
        <!-- İletişim Bilgileri -->
        <div class="space-y-8 pt-8">
          <div class="flex items-start gap-4">
            <div
              class="bg-blue-100 text-blue-700 rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0"
            >
              <Phone class="w-6 h-6" />
            </div>
            <div>
              <h3 class="font-medium text-lg text-slate-900">
                Acil Durum Hattı
              </h3>
              <p class="text-slate-600">7/24 bize ulaşabilirsiniz.</p>
              <a
                href="tel:05416247982"
                class="text-blue-700 font-semibold text-xl hover:underline"
                >0541 624 79 82</a
              >
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div
              class="bg-blue-100 text-blue-700 rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0"
            >
              <Mail class="w-6 h-6" />
            </div>
            <div>
              <h3 class="font-medium text-lg text-slate-900">E-posta</h3>
              <p class="text-slate-600">Teklif ve bilgi almak için yazın.</p>
              <a
                href="mailto:info@alfacilingir.com"
                class="text-blue-700 font-semibold text-xl hover:underline"
                >info@alfacilingir.com</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
