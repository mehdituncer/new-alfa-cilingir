---
import Layout from "../layouts/Layout.astro";
import { MoveRight, Car, Vault, DoorClosedLocked, Lock } from "@lucide/astro";
---

<Layout title="Alfa Çilingir - Modern ve Hızlı Çilingir Hizmeti">
  <!-- Hero Alanı -->
  <section class="bg-white">
    <div
      class="container mx-auto px-6 py-12 flex flex-col sm:flex-row gap-12 items-center justify-between"
    >
      <div class="text-center md:text-left">
        <div class="space-y-4">
          <div
            class="inline-flex items-center space-x-2 bg-green-100 px-3 py-1 rounded-full"
          >
            <span class="w-3 h-3 bg-green-500 rounded-full animate-pulse"
            ></span>
            <span class="text-green-700 font-semibold text-sm"
              >Çevrimiçiyiz</span
            >
          </div>

          <h2
            class="text-4xl lg:text-6xl font-semibold text-slate-900 leading-tight mb-4"
          >
            Kapıda mı kaldınız? <br class="hidden md:block" />Hemen gelelim.
          </h2>
        </div>
        <p class="text-lg text-slate-600 mb-8 max-w-lg mx-auto md:mx-0">
          Arayın, uzman ekibimiz <span
            class="underline decoration-wavy decoration-blue-700">15 dk'da</span
          >
          adresinizde olsun.
        </p>
        <div
          class="flex flex-col sm:flex-row justify-center md:justify-start gap-4"
        >
          <a
            href="tel:05411261760"
            class="flex items-center justify-center gap-1 bg-blue-700 text-white font-medium py-3 px-8 rounded-lg hover:bg-blue-800 transition-transform transform hover:scale-105 shadow-lg"
            >Şimdi Arayın <MoveRight class="text-2xl" /></a
          >
          <a
            href="https://wa.me/905411261760"
            target="_blank"
            class="flex items-center justify-center gap-1 bg-slate-800 text-white font-medium py-3 px-8 rounded-lg hover:bg-slate-900 transition-transform transform hover:scale-105 shadow-lg"
            ><svg
              stroke="currentColor"
              fill="currentColor"
              stroke-width="0"
              viewBox="0 0 24 24"
              class="text-2xl"
              height="1em"
              width="1em"
              xmlns="http://www.w3.org/2000/svg"
              ><path
                d="M7.25361 18.4944L7.97834 18.917C9.18909 19.623 10.5651 20 12.001 20C16.4193 20 20.001 16.4183 20.001 12C20.001 7.58172 16.4193 4 12.001 4C7.5827 4 4.00098 7.58172 4.00098 12C4.00098 13.4363 4.37821 14.8128 5.08466 16.0238L5.50704 16.7478L4.85355 19.1494L7.25361 18.4944ZM2.00516 22L3.35712 17.0315C2.49494 15.5536 2.00098 13.8345 2.00098 12C2.00098 6.47715 6.47813 2 12.001 2C17.5238 2 22.001 6.47715 22.001 12C22.001 17.5228 17.5238 22 12.001 22C10.1671 22 8.44851 21.5064 6.97086 20.6447L2.00516 22ZM8.39232 7.30833C8.5262 7.29892 8.66053 7.29748 8.79459 7.30402C8.84875 7.30758 8.90265 7.31384 8.95659 7.32007C9.11585 7.33846 9.29098 7.43545 9.34986 7.56894C9.64818 8.24536 9.93764 8.92565 10.2182 9.60963C10.2801 9.76062 10.2428 9.95633 10.125 10.1457C10.0652 10.2428 9.97128 10.379 9.86248 10.5183C9.74939 10.663 9.50599 10.9291 9.50599 10.9291C9.50599 10.9291 9.40738 11.0473 9.44455 11.1944C9.45903 11.25 9.50521 11.331 9.54708 11.3991C9.57027 11.4368 9.5918 11.4705 9.60577 11.4938C9.86169 11.9211 10.2057 12.3543 10.6259 12.7616C10.7463 12.8783 10.8631 12.9974 10.9887 13.108C11.457 13.5209 11.9868 13.8583 12.559 14.1082L12.5641 14.1105C12.6486 14.1469 12.692 14.1668 12.8157 14.2193C12.8781 14.2457 12.9419 14.2685 13.0074 14.2858C13.0311 14.292 13.0554 14.2955 13.0798 14.2972C13.2415 14.3069 13.335 14.2032 13.3749 14.1555C14.0984 13.279 14.1646 13.2218 14.1696 13.2222V13.2238C14.2647 13.1236 14.4142 13.0888 14.5476 13.097C14.6085 13.1007 14.6691 13.1124 14.7245 13.1377C15.2563 13.3803 16.1258 13.7587 16.1258 13.7587L16.7073 14.0201C16.8047 14.0671 16.8936 14.1778 16.8979 14.2854C16.9005 14.3523 16.9077 14.4603 16.8838 14.6579C16.8525 14.9166 16.7738 15.2281 16.6956 15.3913C16.6406 15.5058 16.5694 15.6074 16.4866 15.6934C16.3743 15.81 16.2909 15.8808 16.1559 15.9814C16.0737 16.0426 16.0311 16.0714 16.0311 16.0714C15.8922 16.159 15.8139 16.2028 15.6484 16.2909C15.391 16.428 15.1066 16.5068 14.8153 16.5218C14.6296 16.5313 14.4444 16.5447 14.2589 16.5347C14.2507 16.5342 13.6907 16.4482 13.6907 16.4482C12.2688 16.0742 10.9538 15.3736 9.85034 14.402C9.62473 14.2034 9.4155 13.9885 9.20194 13.7759C8.31288 12.8908 7.63982 11.9364 7.23169 11.0336C7.03043 10.5884 6.90299 10.1116 6.90098 9.62098C6.89729 9.01405 7.09599 8.4232 7.46569 7.94186C7.53857 7.84697 7.60774 7.74855 7.72709 7.63586C7.85348 7.51651 7.93392 7.45244 8.02057 7.40811C8.13607 7.34902 8.26293 7.31742 8.39232 7.30833Z"
              ></path></svg
            > Whatsapp</a
          >
        </div>
      </div>
      <div class="flex items-center justify-center w-full sm:w-1/2">
        <img
          src="/hero-image.svg"
          alt="Çilingir"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Hizmetlerimiz Alanı -->
  <section class="py-24 bg-slate-50">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-semibold text-slate-900">Hizmetlerimiz</h2>
        <p class="text-slate-600 mt-4 max-w-2xl mx-auto">
          Güvenliğiniz için en modern ekipmanlar ve uzman kadromuzla 7/24
          hizmetinizdeyiz.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Hizmet Kartı 1 -->
        <a
          href="/hizmetler/kapi-acma"
          class="bg-white p-8 rounded-xl shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 block"
        >
          <div
            class="bg-blue-100 text-blue-700 rounded-full w-16 h-16 flex items-center justify-center mb-6"
          >
            <DoorClosedLocked class="size-8" />
          </div>

          <h3 class="font-bold text-xl mb-3 text-slate-900">Kapı Açma</h3>
          <p class="text-slate-600 text-sm">
            Modern ekipmanlarımızla kapınıza zarar vermeden, hızlı ve güvenli
            kapı açma hizmeti.
          </p>
        </a>
        <!-- Hizmet Kartı 2 -->
        <a
          href="/hizmetler/kilit-degisimi"
          class="bg-white p-8 rounded-xl shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 block"
        >
          <div
            class="bg-blue-100 text-blue-700 rounded-full w-16 h-16 flex items-center justify-center mb-6"
          >
            <Lock class="size-8" />
          </div>
          <h3 class="font-bold text-xl mb-3 text-slate-900">Kilit Değişimi</h3>
          <p class="text-slate-600 text-sm">
            Güvenliğinizi artırmak için eski veya bozuk kilitlerinizi
            yenileriyle değiştiriyoruz.
          </p>
        </a>
        <!-- Hizmet Kartı 3 -->
        <a
          href="/hizmetler/oto-cilingir"
          class="bg-white p-8 rounded-xl shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 block"
        >
          <div
            class="bg-blue-100 text-blue-700 rounded-full w-16 h-16 flex items-center justify-center mb-6"
          >
            <Car class="size-8" />
          </div>
          <h3 class="font-bold text-xl mb-3 text-slate-900">Oto Çilingir</h3>
          <p class="text-slate-600 text-sm">
            Aracınızın kapısını, markası ne olursa olsun, hasarsız bir şekilde
            açıyoruz.
          </p>
        </a>
        <!-- Hizmet Kartı 4 -->
        <a
          href="/hizmetler/kasa-acma"
          class="bg-white p-8 rounded-xl shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 block"
        >
          <div
            class="bg-blue-100 text-blue-700 rounded-full w-16 h-16 flex items-center justify-center mb-6"
          >
            <Vault class="size-8" />
          </div>
          <h3 class="font-bold text-xl mb-3 text-slate-900">Kasa Açma</h3>
          <p class="text-slate-600 text-sm">
            Her türlü şifreli veya anahtarlı kasayı, özel ekipmanlarımızla
            profesyonelce açıyoruz.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- Hizmet Bölgeleri -->
  <section class="py-24">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-semibold text-slate-900">
          Hizmet Bölgelerimiz
        </h2>
        <p class="text-slate-600 mt-4 max-w-2xl mx-auto">
          İstanbul'un Avrupa yakasında birçok noktaya 30 dakikadan az sürede
          ulaşıyoruz.
        </p>
      </div>
      <div class="flex flex-wrap justify-center items-center gap-4">
        <span
          class="bg-white shadow-md py-3 px-6 rounded-full text-lg font-semibold text-slate-700"
          >Beylikdüzü</span
        >
        <span
          class="bg-white shadow-md py-3 px-6 rounded-full text-lg font-semibold text-slate-700"
          >Büyükçekmece</span
        >
        <span
          class="bg-white shadow-md py-3 px-6 rounded-full text-lg font-semibold text-slate-700"
          >Esenyurt</span
        >
        <span
          class="bg-white shadow-md py-3 px-6 rounded-full text-lg font-semibold text-slate-700"
          >Avcılar</span
        >
        <span
          class="bg-white shadow-md py-3 px-6 rounded-full text-lg font-semibold text-slate-700"
          >Bahçeşehir</span
        >
      </div>
    </div>
  </section>

  <!-- Sık Sorulan Sorular -->
  <section class="py-24 bg-slate-50">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: [
          {
            "@type": "Question",
            name: "Hizmet süresi ne kadar?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Çağrı aldıktan sonra genellikle 15-20 dakika içinde adresinizde oluyoruz. Trafik ve yol durumuna göre bu süre değişiklik gösterebilir.",
            },
          },
          {
            "@type": "Question",
            name: "Kapı açma işlemi sırasında kapıma zarar verir misiniz?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Hayır, profesyonel ekibimiz ve özel ekipmanlarımız sayesinde kapınıza zarar vermeden açma işlemini gerçekleştiriyoruz. Müşteri memnuniyeti bizim için önceliktir.",
            },
          },
          {
            "@type": "Question",
            name: "Ödeme yöntemleri nelerdir?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Nakit, kredi kartı ve mobil ödeme (EFT/Havale) yöntemleriyle ödeme yapabilirsiniz.",
            },
          },
          {
            "@type": "Question",
            name: "Garanti veriyor musunuz?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Evet, tüm kilit değişim ve tamir işlemlerimiz için 1 yıl garanti veriyoruz. Kullandığımız ürünler orijinal ve kalitelidir.",
            },
          },
          {
            "@type": "Question",
            name: "Güncel çilingir fiyatları ne kadar?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Türkiye genelinde çilingir kapı açma fiyatları 400 TL ile 1.600 TL arasında değişmektedir. Detaylı bilgi almak için iletişime geçebilirsiniz.",
            },
          },
        ],
      })}
    />
    <div class="container mx-auto px-6 max-w-3xl">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-semibold text-slate-900">Sık Sorun Sorular</h2>
        <p class="text-slate-600 mt-4">
          Aklınıza takılan soruların cevaplarını burada bulabilirsiniz.
        </p>
      </div>
      <div class="space-y-4">
        <details class="bg-white p-6 rounded-xl shadow-lg group" open>
          <summary
            class="font-semibold text-lg cursor-pointer flex justify-between items-center"
          >
            Hizmet süresi ne kadar?
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5 group-open:rotate-180 transition-transform"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path></svg
            >
          </summary>
          <p class="mt-4 text-slate-600">
            Çağrı aldıktan sonra genellikle 15-20 dakika içinde adresinizde
            oluyoruz. Trafik ve yol durumuna göre bu süre değişiklik
            gösterebilir.
          </p>
        </details>
        <details class="bg-white p-6 rounded-xl shadow-lg group">
          <summary
            class="font-semibold text-lg cursor-pointer flex justify-between items-center"
          >
            Kapı açma işlemi sırasında kapıma zarar verir misiniz?
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5 group-open:rotate-180 transition-transform"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path></svg
            >
          </summary>
          <p class="mt-4 text-slate-600">
            Hayır, profesyonel ekibimiz ve özel ekipmanlarımız sayesinde
            kapınıza zarar vermeden açma işlemini gerçekleştiriyoruz. Müşteri
            memnuniyeti bizim için önceliktir.
          </p>
        </details>
        <details class="bg-white p-6 rounded-xl shadow-lg group">
          <summary
            class="font-semibold text-lg cursor-pointer flex justify-between items-center"
          >
            Ödeme yöntemleri nelerdir?
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5 group-open:rotate-180 transition-transform"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path></svg
            >
          </summary>
          <p class="mt-4 text-slate-600">
            Nakit, kredi kartı ve mobil ödeme (EFT/Havale) yöntemleriyle ödeme
            yapabilirsiniz.
          </p>
        </details>
        <details class="bg-white p-6 rounded-xl shadow-lg group">
          <summary
            class="font-semibold text-lg cursor-pointer flex justify-between items-center"
          >
            Garanti veriyor musunuz?
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5 group-open:rotate-180 transition-transform"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path></svg
            >
          </summary>
          <p class="mt-4 text-slate-600">
            Evet, tüm kilit değişim ve tamir işlemlerimiz için 1 yıl garanti
            veriyoruz. Kullandığımız ürünler orijinal ve kalitelidir.
          </p>
        </details>
        <details class="bg-white p-6 rounded-xl shadow-lg group">
          <summary
            class="font-semibold text-lg cursor-pointer flex justify-between items-center"
          >
            Güncel çilingir fiyatları ne kadar?
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5 group-open:rotate-180 transition-transform"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path></svg
            >
          </summary>
          <p class="mt-4 text-slate-600">
            Türkiye genelinde çilingir kapı açma fiyatları 400 TL ile 1.600 TL
            arasında değişmektedir. Detaylı bilgi almak için iletişime
            geçebilirsiniz.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Blog Alanı -->
  <section class="py-24">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-semibold text-slate-900">Blog</h2>
        <p class="text-slate-600 mt-4">
          Güvenlik ve çilingirlik dünyasından son haberler ve ipuçları.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <a
          href="/bolgeler/beylikduzu-cilingir"
          class="bg-white rounded-xl shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 block overflow-hidden"
        >
          <img
            src="https://images.unsplash.com/photo-1563729998-8ide48c306a4?q=80&w=1974&auto=format&fit=crop"
            class="w-full h-48 object-cover"
            alt="Beylikdüzü Çilingir"
          />
          <div class="p-6">
            <h3 class="font-bold text-xl mb-3 text-slate-900">
              Beylikdüzü Çilingir: 15 Dakikada Yanınızdayız!
            </h3>
            <p class="text-slate-600 text-sm mb-4">
              Beylikdüzü'nde kapıda mı kaldınız? Acil çilingir ihtiyacınız için
              profesyonel çözümler sunuyoruz.
            </p>
            <span class="font-semibold text-blue-700">Devamını Oku &rarr;</span>
          </div>
        </a>
        <a
          href="/bolgeler/buyukcekmece-cilingir"
          class="bg-white rounded-xl shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 block overflow-hidden"
        >
          <img
            src="https://images.unsplash.com/photo-1617053313489-42c384a4b2a8?q=80&w=1964&auto=format&fit=crop"
            class="w-full h-48 object-cover"
            alt="Büyükçekmece Çilingir"
          />
          <div class="p-6">
            <h3 class="font-bold text-xl mb-3 text-slate-900">
              Büyükçekmece Çilingir: Güvenilir ve Hızlı Çözümler
            </h3>
            <p class="text-slate-600 text-sm mb-4">
              Büyükçekmece ve çevresinde 7/24 kesintisiz, garantili çilingir
              hizmeti sunuyoruz.
            </p>
            <span class="font-semibold text-blue-700">Devamını Oku &rarr;</span>
          </div>
        </a>
        <a
          href="#"
          class="bg-white rounded-xl shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 block overflow-hidden"
        >
          <img
            src="https://images.unsplash.com/photo-1560041136-5d2d8a933de3?q=80&w=1974&auto=format&fit=crop"
            class="w-full h-48 object-cover"
            alt="Kilit Seçimi"
          />
          <div class="p-6">
            <h3 class="font-bold text-xl mb-3 text-slate-900">
              Doğru Kilit Seçimi Nasıl Yapılır?
            </h3>
            <p class="text-slate-600 text-sm mb-4">
              Güvenliğiniz için en doğru kilidi seçerken nelere dikkat etmeniz
              gerektiğini anlatıyoruz.
            </p>
            <span class="font-semibold text-blue-700">Devamını Oku &rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>
</Layout>
