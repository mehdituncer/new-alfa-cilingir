---
import '../styles/global.css';
import '@fontsource-variable/manrope';
import Icon from '../components/Icon.astro';
import { business,regions,services } from '../data/site';
const { title='Alfa Çilingir | İstanbul’un Batısında Çilingir', description='Beylikdüzü, Esenyurt, Büyükçekmece, Avcılar ve Bahçeşehir’de kapı açma, oto çilingir, kasa açma ve kilit değişimi. Alfa Çilingir: 0541 608 37 71.', schema=[], crumbs=[] }=Astro.props;
const origin=Astro.site!.origin;
const canonical=new URL(Astro.url.pathname,origin).href;
const path=Astro.url.pathname;
const localBusiness={'@type':'Locksmith','@id':origin+'/#business',name:business.name,url:origin+'/',telephone:'+905416083771',address:{'@type':'PostalAddress',addressRegion:'İstanbul',addressCountry:'TR'},areaServed:regions.map(r=>({'@type':'Place',name:r.name+', İstanbul'})),openingHoursSpecification:[{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],opens:'07:00',closes:'00:00'}]};
const graph=[localBusiness,{'@type':'WebSite','@id':origin+'/#website',url:origin+'/',name:business.name,inLanguage:'tr-TR',publisher:{'@id':origin+'/#business'}},{'@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:title,description,inLanguage:'tr-TR',isPartOf:{'@id':origin+'/#website'},about:{'@id':origin+'/#business'}},...(crumbs.length?[{'@type':'BreadcrumbList',itemListElement:[{name:'Ana Sayfa',url:'/'},...crumbs].map((c,i)=>({'@type':'ListItem',position:i+1,name:c.name,item:new URL(c.url,origin).href}))}]:[]),...schema];
const nav=[['/','Ana Sayfa'],['/hizmetler/','Hizmetler'],['/bolgeler/','Bölgeler'],['/blog/','Blog'],['/iletisim/','İletişim']];
const isActive=(href:string)=>href==='/'?path==='/':path.startsWith(href);
---
<!doctype html><html lang="tr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="theme-color" content="#2563eb"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/png" href="/favicon.png"/><meta property="og:type" content="website"/><meta property="og:locale" content="tr_TR"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta name="twitter:card" content="summary"/><script is:inline>document.documentElement.classList.add('js')</script><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/></head>
<body><a class="skip-link" href="#main">İçeriğe geç</a>
 <header class="header"><div class="container header-inner"><a href="/" class="brand" aria-label="Alfa Çilingir ana sayfa"><img src="/alfalogo.svg" alt="Alfa Çilingir" class="brand-logo" width="230" height="36"/></a>
 <nav class="desktop-nav" aria-label="Ana menü">{nav.map(([href,label])=><a class:list={{active:isActive(href)}} href={href} aria-current={isActive(href)?'page':undefined}>{label}</a>)}</nav>
 <div class="header-actions"><a class="header-phone" href={business.tel}><Icon name="phone" size={20}/><span class="header-phone-text">{business.phone}</span></a><button class="menu-toggle" aria-label="Menüyü aç" aria-controls="mobile-nav" aria-expanded="false"><Icon name="menu" size={24}/></button></div></div>
 <nav id="mobile-nav" class="mobile-nav" aria-label="Mobil menü" hidden><div class="container">{nav.map(([href,label])=><a class:list={{active:isActive(href)}} href={href} aria-current={isActive(href)?'page':undefined}>{label}<Icon name="chevron" size={18}/></a>)}</div></nav></header>
 <main id="main">{crumbs.length>0&&<nav class="container breadcrumbs" aria-label="İçerik yolu"><a href="/">Ana Sayfa</a>{crumbs.map((c,i)=><><Icon name="chevron" size={14}/>{i===crumbs.length-1?<span aria-current="page">{c.name}</span>:<a href={c.url}>{c.name}</a>}</>)}</nav>}<slot/></main>
 <footer class="footer"><div class="container footer-grid"><div class="footer-about"><a href="/" class="brand" aria-label="Alfa Çilingir ana sayfa"><img src="/alfalogo.svg" alt="Alfa Çilingir" class="brand-logo" width="230" height="36"/></a><p>Kapınızda bir sorun varsa,<br/>bir telefon kadar yakınız.</p><a class="footer-number" href={business.tel}>{business.phone}</a><a class="footer-social" href={business.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="chat" size={20}/> WhatsApp’tan yazın <Icon name="arrow" size={16}/></a></div><div class="footer-col"><h3>Hizmetlerimiz</h3>{services.map(s=><a href={'/hizmetler/'+s.slug+'/'}>{s.title}</a>)}</div><div class="footer-col"><h3>Hizmet bölgeleri</h3>{regions.map(r=><a href={'/bolgeler/'+r.slug+'/'}>{r.name} çilingir</a>)}<a href="/blog/">Çilingir rehberi</a></div><div class="footer-col"><h3>Bize ulaşın</h3><p class="footer-hours">Her gün · 07.00–00.00</p><a href="/iletisim/">İletişim bilgileri</a><a href="/gizlilik/">Gizlilik politikası</a></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Alfa Çilingir. Tüm hakları saklıdır.</span><span>İstanbul’un batısında hizmet</span></div></footer>
 <div class="fixed-contact" aria-label="Hızlı iletişim"><a class="fixed-wa" href={business.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp ile mesaj gönder"><Icon name="chat" size={22}/><span>WhatsApp</span></a><a class="fixed-call" href={business.tel} aria-label="Alfa Çilingir’i ara: 0541 608 37 71"><Icon name="phone" size={20}/><span>Hemen ara</span></a></div>
 <script is:inline>
 (function(){
  var els=[].slice.call(document.querySelectorAll('[data-reveal]'));
  if(!els.length)return;
  var show=function(el){el.classList.add('in')};
  try{
   if(!('IntersectionObserver' in window)){els.forEach(show);return}
   els.forEach(function(el){var siblings=[].filter.call(el.parentElement.children,function(c){return c.hasAttribute('data-reveal')});el.style.setProperty('--d',Math.min(siblings.indexOf(el),5)*70+'ms')});
   var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){show(e.target);io.unobserve(e.target)}})},{threshold:.08,rootMargin:'0px 0px -5% 0px'});
   els.forEach(function(el){io.observe(el)});
  }catch(err){els.forEach(show)}
 })();
 </script>
 <script>
 import {getAvailability} from '../data/availability';
 const button=document.querySelector<HTMLButtonElement>('.menu-toggle');const menu=document.querySelector<HTMLElement>('#mobile-nav');
 const closeMenu=()=>{button?.setAttribute('aria-expanded','false');button?.setAttribute('aria-label','Menüyü aç');if(menu)menu.hidden=true;};
 button?.addEventListener('click',()=>{const expanded=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!expanded));button.setAttribute('aria-label',expanded?'Menüyü aç':'Menüyü kapat');if(menu)menu.hidden=expanded;});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeMenu();button?.focus();}});
 function updateStatus(){const online=getAvailability(new Date());document.querySelectorAll<HTMLElement>('[data-availability]').forEach(el=>{el.classList.toggle('online',online);el.classList.toggle('offline',!online);const label=el.querySelector('[data-status-text]');if(label)label.textContent=online?'Çevrim içi · Size yardımcı olmaya hazırız':'Şu an çevrim dışı · 07.00’de buradayız';});}
 updateStatus();setInterval(updateStatus,30000);
 </script>
</body></html>
