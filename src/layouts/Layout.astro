---
import '../styles/global.css';
import '@fontsource-variable/manrope';
import Icon from '../components/Icon.astro';
import { business,regions,services } from '../data/site';
const { title='Alfa Çilingir | Beylikdüzü ve Çevresinde Çilingir', description='Beylikdüzü, Esenyurt, Büyükçekmece, Avcılar ve Bahçeşehir’de kapı açma, oto çilingir, kasa açma ve kilit değişimi. Alfa Çilingir: 0541 608 37 71.', schema=[], crumbs=[] }=Astro.props;
const origin=Astro.site!.origin;
const canonical=new URL(Astro.url.pathname,origin).href;
const path=Astro.url.pathname;
const localBusiness={'@type':'Locksmith','@id':origin+'/#business',name:business.name,url:origin+'/',telephone:'+905416083771',address:{'@type':'PostalAddress',streetAddress:'Büyükşehir Mahallesi, Cumhuriyet Caddesi, Derya Sokak No: 35',addressLocality:'Beylikdüzü',addressRegion:'İstanbul',addressCountry:'TR'},areaServed:regions.map(r=>({'@type':'Place',name:r.name+', İstanbul'})),openingHoursSpecification:[{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],opens:'07:00',closes:'00:00'}],hasMap:business.maps};
const graph=[localBusiness,{'@type':'WebSite','@id':origin+'/#website',url:origin+'/',name:business.name,inLanguage:'tr-TR',publisher:{'@id':origin+'/#business'}},{'@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:title,description,inLanguage:'tr-TR',isPartOf:{'@id':origin+'/#website'},about:{'@id':origin+'/#business'}},...(crumbs.length?[{'@type':'BreadcrumbList',itemListElement:[{name:'Ana Sayfa',url:'/'},...crumbs].map((c,i)=>({'@type':'ListItem',position:i+1,name:c.name,item:new URL(c.url,origin).href}))}]:[]),...schema];
---
<!doctype html><html lang="tr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="theme-color" content="#2563eb"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:type" content="website"/><meta property="og:locale" content="tr_TR"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta name="twitter:card" content="summary"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/></head>
<body><a class="skip-link" href="#main">İçeriğe geç</a>
 <div class="topbar"><div class="container"><span><Icon name="pin" size={14}/> Beylikdüzü’nden İstanbul’un batısına</span><span><Icon name="clock" size={14}/> Her gün 07.00–00.00</span></div></div>
 <header class="header"><div class="container header-inner"><a href="/" class="brand" aria-label="Alfa Çilingir ana sayfa"><span class="brand-symbol"><Icon name="key" size={25}/></span><span>alfa<span class="brand-sub">ÇİLİNGİR</span></span></a>
 <nav class="desktop-nav" aria-label="Ana menü">{[['/','Ana Sayfa'],['/hizmetler/','Hizmetler'],['/bolgeler/','Bölgeler'],['/blog/','Blog'],['/iletisim/','İletişim']].map(([href,label])=><a class:list={{active:href==='/'?path==='/':path.startsWith(href)}} href={href} aria-current={(href==='/'?path==='/':path.startsWith(href))?'page':undefined}>{label}</a>)}</nav>
 <a class="header-phone" href={business.tel}><Icon name="phone" size={17}/>{business.phone}</a><button class="menu-toggle" aria-label="Menüyü aç" aria-controls="mobile-nav" aria-expanded="false"><Icon name="menu"/></button></div>
 <nav id="mobile-nav" class="mobile-nav" aria-label="Mobil menü" hidden>{[['/','Ana Sayfa'],['/hizmetler/','Hizmetler'],['/bolgeler/','Bölgeler'],['/blog/','Blog'],['/iletisim/','İletişim']].map(([href,label])=><a href={href}>{label}<Icon name="chevron" size={16}/></a>)}</nav></header>
 <main id="main">{crumbs.length>0&&<nav class="container breadcrumbs" aria-label="İçerik yolu"><a href="/">Ana Sayfa</a>{crumbs.map((c,i)=><><Icon name="chevron" size={13}/>{i===crumbs.length-1?<span aria-current="page">{c.name}</span>:<a href={c.url}>{c.name}</a>}</>)}</nav>}<slot/></main>
 <footer class="footer"><div class="container footer-grid"><div class="footer-about"><a href="/" class="brand"><span class="brand-symbol"><Icon name="key" size={25}/></span><span>alfa<span class="brand-sub">ÇİLİNGİR</span></span></a><p>Kapınızda bir sorun varsa,<br/>bir telefon kadar yakınız.</p><a class="footer-number" href={business.tel}>{business.phone}</a><a class="footer-social" href={business.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="chat" size={18}/> WhatsApp’tan yazın <Icon name="arrow" size={14}/></a></div><div><h3>Hizmetlerimiz</h3>{services.map(s=><a href={'/hizmetler/'+s.slug+'/'}>{s.title}</a>)}</div><div><h3>Hizmet bölgeleri</h3>{regions.map(r=><a href={'/bolgeler/'+r.slug+'/'}>{r.name} çilingir</a>)}<a href="/blog/">Çilingir rehberi</a></div><div><h3>Bize ulaşın</h3><p class="footer-address">{business.address}</p><a href={business.maps} target="_blank" rel="noopener noreferrer" class="map-link">Haritada görüntüle <Icon name="arrow" size={15}/></a><p class="hours">Her gün · 07.00–00.00</p><a href="/iletisim/">İletişim bilgileri</a><a href="/gizlilik/">Gizlilik politikası</a></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Alfa Çilingir. Tüm hakları saklıdır.</span><span>Beylikdüzü · İstanbul</span></div></footer>
 <div class="fixed-contact" aria-label="Hızlı iletişim"><a class="fixed-wa" href={business.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp ile mesaj gönder"><Icon name="chat" size={21}/><span>WhatsApp</span></a><a class="fixed-call" href={business.tel} aria-label="Alfa Çilingir’i ara: 0541 608 37 71"><Icon name="phone" size={19}/><span>Hemen ara</span></a></div>
 <script>
 import {getAvailability} from '../data/availability';
 const button=document.querySelector<HTMLButtonElement>('.menu-toggle');const menu=document.querySelector<HTMLElement>('#mobile-nav');
 const closeMenu=()=>{button?.setAttribute('aria-expanded','false');button?.setAttribute('aria-label','Menüyü aç');if(menu)menu.hidden=true;};
 button?.addEventListener('click',()=>{const expanded=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!expanded));button.setAttribute('aria-label',expanded?'Menüyü aç':'Menüyü kapat');if(menu)menu.hidden=expanded;});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeMenu();button?.focus();}});
 function updateStatus(){const online=getAvailability(new Date());document.querySelectorAll<HTMLElement>('[data-availability]').forEach(el=>{el.classList.toggle('online',online);el.classList.toggle('offline',!online);const label=el.querySelector('[data-status-text]');if(label)label.textContent=online?'Çevrim içi · Size yardımcı olmaya hazırız':'Şu an çevrim dışı · 07.00’de buradayız';});}
 updateStatus();setInterval(updateStatus,30000);
 </script>
</body></html>
